<%# Show success notification %>
<%= turbo_stream.prepend "main" do %>
  <div class="container">
    <%= render 'components/alert', variant: 'success', message: flash[:notice] %>
  </div>
<% end %>

<%# Update participants list %>
<%= turbo_stream.replace "participants-list" do %>
  <%= render "game_sessions/participants_list", game_session: @game_session %>
<% end %>

<%# Update progress section %>
<%= turbo_stream.replace "progress-section" do %>
  <%= render "game_sessions/progress_bar", game_session: @game_session %>
<% end %>

<%# Update spots remaining %>
<%= turbo_stream.replace "spots-remaining-section" do %>
  <p class="text-xs text-secondary uppercase tracking-wide mb-1">Available</p>
  <p class="text-xl font-bold"><%= @game_session.spots_remaining %></p>
<% end %>

<%# Update participate button - user has now purchased %>
<%= turbo_stream.replace "participate-button" do %>
  <%= render "game_sessions/participate_button", game_session: @game_session, user_has_purchased: true %>
<% end %>

<%# Update user's credit display %>
<%= turbo_stream.replace "user-credits-display-#{current_user.id}" do %>
  <%= current_user.user_credit_wallet.total_credits %>
<% end %>

<%# Update navbar credits %>
<%= turbo_stream.replace "user-wallet-navbar-#{current_user.id}" do %>
  <div id="user-wallet-navbar-#{current_user.id}" class="credit-badge">
    <strong><%= current_user.user_credit_wallet.total_credits %></strong>
    <span>credits</span>
  </div>
<% end %>

<% if user_signed_in? && current_user.user_credit_wallet %>
  <div class="wallet-card" style="display: flex; align-items: center; justify-content: space-between;">
    <div>
      <p class="wallet-header">Available Credits</p>
      <p class="wallet-amount">
        <%= current_user.user_credit_wallet.total_credits - current_user.user_credit_wallet.locked_credits %>
      </p>
    </div>
    <%= link_to "Buy More", credit_purchases_path, class: "btn btn-primary" %>
  </div>
<% end %>

<nav>
  <div class="container">
    <div class="nav-content">
      <div class="nav-left">
        <%= link_to "BTC Play", root_path, class: "nav-brand" %>

        <% if user_signed_in? %>
          <%= link_to "Buy Credits", credit_purchases_path, class: "nav-link" %>
        <% end %>
      </div>

      <div class="nav-links">
        <% if user_signed_in? %>
          <% if current_user.user_credit_wallet %>
            <div class="credit-badge">
              <strong><%= current_user.user_credit_wallet.total_credits - current_user.user_credit_wallet.locked_credits %></strong>
              <span>credits</span>
            </div>
          <% end %>

          <span class="nav-username"><%= current_user.username %></span>
          <%= button_to "Sign Out", destroy_user_session_path,
              method: :delete,
              class: "btn btn-ghost",
              data: { turbo: false } %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "nav-link" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>

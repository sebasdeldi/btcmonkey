<% return if wallet.nil? %>
<% user ||= wallet.user %>
<% available_credits ||= wallet.total_credits %>

<div id="user-wallet-card-<%= user.id %>" class="wallet-card">
  <p class="wallet-header">Your Current Balance</p>
  <p class="wallet-amount">
    <%= available_credits %>
    <span class="wallet-amount-label">credits</span>
  </p>
</div>

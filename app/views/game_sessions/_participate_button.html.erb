<% if user_has_purchased %>
  <%= render 'components/badge', text: 'Already Participating', variant: 'success' %>
<% elsif !game_session.accepting_purchases? %>
  <%= render 'components/badge', text: 'Session Full', variant: 'gray' %>
<% else %>
  <%= button_to game_session_spots_path(game_session),
      method: :post,
      class: 'btn btn-primary btn-full',
      data: { turbo: true } do %>
    Participate (<%= game_session.price_in_credits %> credits)
  <% end %>
<% end %>

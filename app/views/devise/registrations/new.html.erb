<div class="container py-8">
  <div class="auth-container">
    <div class="auth-card">
      <h2>Sign up</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= render 'components/form_field', form: f, field: :username, type: 'text', label: 'Username' %>

        <%= render 'components/form_field', form: f, field: :email, type: 'email' %>

        <%= render 'components/form_field',
            form: f,
            field: :password,
            type: 'password',
            helper: @minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil %>

        <%= render 'components/form_field',
            form: f,
            field: :password_confirmation,
            type: 'password',
            label: 'Confirm password' %>

        <div class="form-group">
          <%= f.submit "Sign up", class: "btn btn-primary btn-full" %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>

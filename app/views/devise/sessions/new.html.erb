<div class="container py-8">
  <div class="auth-container">
    <div class="auth-card">
      <h2>Log in</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <%= render 'components/form_field', form: f, field: :email, type: 'email' %>

        <%= render 'components/form_field', form: f, field: :password, type: 'password' %>

        <% if devise_mapping.rememberable? %>
          <%= render 'components/form_field', form: f, field: :remember_me, type: 'checkbox', label: 'Remember me' %>
        <% end %>

        <div class="form-group">
          <%= f.submit "Log in", class: "btn btn-primary btn-full" %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>

<div class="container py-8">
  <div class="card">
    <div class="card-body">
      <!-- Session Info -->
      <div class="mb-6">
        <h1 class="text-2xl font-bold mb-2">Number Sequence Memory Game</h1>
        <p class="text-gray-600">
          Game Session: <%= @game_session.name %> |
          Run <%= @user_runs.played.count + 1 %> of <%= @user_runs.count %>
        </p>
      </div>

      <!-- Time Remaining -->
      <% if @game_session.last_spot_purchased_at %>
        <% time_limit = @game_session.last_spot_purchased_at + 2.hours %>
        <% time_remaining = ((time_limit - Time.current) / 60).round %>

        <% if time_remaining > 0 %>
          <div class="alert alert-info mb-6" style="background: var(--color-gray-100); padding: var(--space-4); border-radius: var(--radius-md); margin-bottom: var(--space-6);">
            <strong>Time Window:</strong> You have <%= time_remaining %> minutes remaining to complete your game runs.
          </div>
        <% else %>
          <div class="alert alert-warning mb-6" style="background: var(--color-error-light); padding: var(--space-4); border-radius: var(--radius-md); margin-bottom: var(--space-6); color: var(--color-error-dark);">
            <strong>Warning:</strong> Play window has expired. This game may be forfeited.
          </div>
        <% end %>
      <% end %>

      <!-- Game Container -->
      <div class="game-container"
           data-controller="number-sequence-game"
           data-number-sequence-game-grid-layout-value="<%= @grid_layout.to_json %>"
           data-number-sequence-game-game-run-url-value="<%= game_run_path(@game_run) %>"
           data-number-sequence-game-current-username-value="<%= current_user.username %>"
           data-number-sequence-game-leaderboard-value="<%= @leaderboard.to_json %>">

        <!-- Exit Warning Modal -->
        <div data-number-sequence-game-target="exitWarning" class="exit-warning-modal">
          <div class="exit-warning-content">
            <h2 class="exit-warning-title">⚠️ Warning: Exit Game?</h2>
            <p class="exit-warning-text">
              If you close or refresh this window, the game will be marked as <strong>failed</strong> with a score of <strong>1,999,999ms</strong> and <strong>cannot be retried</strong>.
            </p>
            <p class="exit-warning-subtext">
              Your progress will be lost and the spot will be forfeited.
            </p>
            <div class="exit-warning-actions">
              <button type="button"
                      class="btn btn-secondary"
                      data-action="click->number-sequence-game#cancelExit">
                Cancel - Resume Game
              </button>
              <button type="button"
                      class="btn btn-ghost"
                      style="background-color: var(--color-error); color: white;"
                      data-action="click->number-sequence-game#forfeitGame">
                Exit - Forfeit Game
              </button>
            </div>
          </div>
        </div>

        <!-- Memorization Phase -->
        <div data-number-sequence-game-target="instructions" class="memorization-phase">
          <h2 style="font-size: var(--font-size-xl); font-weight: var(--font-weight-bold); margin-bottom: var(--space-4);">Get Ready!</h2>
          <p class="sequence-display" style="margin-bottom: var(--space-4);">
            Click the numbers in order: <strong>1 → 2 → 3 → ... → 25</strong>
          </p>
          <p style="font-size: var(--font-size-lg); margin-bottom: var(--space-2);">Starting in</p>
          <p class="countdown-timer">3</p>
        </div>

        <!-- Game Interface (hidden initially) -->
        <div data-number-sequence-game-target="gameInterface" class="game-interface" style="display: none;">
          <!-- Header -->
          <div class="game-header">
            <div class="timer-display">
              <span class="label">Time:</span>
              <span data-number-sequence-game-target="timer" class="value">0.0s</span>
            </div>

            <div class="progress-display">
              <span class="label">Progress:</span>
              <span data-number-sequence-game-target="progress" class="value">0/25</span>
            </div>

            <div class="next-display">
              <span class="label">Next:</span>
              <span data-number-sequence-game-target="nextNumber" class="value">1</span>
            </div>
          </div>

          <!-- 5x5 Grid -->
          <div data-number-sequence-game-target="grid" class="number-grid">
            <!-- Grid cells generated by JavaScript -->
          </div>
        </div>

        <!-- Completion Screen (hidden initially) -->
        <div data-number-sequence-game-target="completionScreen" class="completion-screen" style="display: none;">
          <div class="completion-content">
            <h2 data-number-sequence-game-target="completionTitle" style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); margin-bottom: var(--space-6); color: var(--color-success);">
              🎉 Complete!
            </h2>

            <div class="completion-stats">
              <div class="stat-item">
                <span class="stat-label">Time</span>
                <span class="stat-value" data-number-sequence-game-target="finalTime">0.0s</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">Score</span>
                <span class="stat-value" data-number-sequence-game-target="finalScore">0</span>
                <span class="stat-max">ms</span>
              </div>
            </div>

            <p data-number-sequence-game-target="rankMessage" style="color: var(--color-gray-600); margin-top: var(--space-4); font-size: var(--font-size-sm);">
              Lower score is better!
            </p>

            <!-- Leaderboard -->
            <div class="leaderboard" style="margin-top: var(--space-8);">
              <h3 style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); margin-bottom: var(--space-4); color: var(--color-primary-navy);">
                🏆 Top 5 Leaderboard
              </h3>
              <div data-number-sequence-game-target="leaderboardList" class="leaderboard-list">
                <!-- Populated by JavaScript -->
              </div>
            </div>

            <p style="color: var(--color-gray-600); margin-top: var(--space-6);">
              Submitting score...
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

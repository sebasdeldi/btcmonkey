<div class="container py-8">
  <div class="transaction-detail-container">
    <%= link_to "← Back to Packages", credit_purchases_path, class: "text-link mb-6" %>

    <div class="card">
      <div class="card-header">
        <h1>Transaction Details</h1>
        <p class="text-muted">Order #<%= @transaction.id %></p>
      </div>

      <div class="card-body">
        <div class="transaction-info-row mb-6">
          <div>
            <p class="text-sm text-muted">Status</p>
            <%= render 'components/status_badge', status: @transaction.status %>
          </div>
          <div class="text-right">
            <p class="text-sm text-muted">Created</p>
            <p class="font-semibold"><%= @transaction.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
          </div>
        </div>

        <% if @transaction.pending? %>
          <%= render 'components/alert',
              variant: 'warning',
              title: '⏳ Waiting for Payment',
              message: 'Your transaction is pending. Please complete the Bitcoin payment to receive your credits.' %>
        <% elsif @transaction.paid? || @transaction.confirmed? %>
          <%= render 'components/alert',
              variant: 'success',
              title: '✓ Payment Confirmed',
              message: "Your payment has been received and #{@transaction.credit_package.credits} credits have been added to your account!" %>
        <% elsif @transaction.expired? %>
          <%= render 'components/alert',
              variant: 'error',
              title: '⚠ Transaction Expired',
              message: 'This transaction has expired. Please create a new purchase if you still want to buy credits.' %>
        <% elsif @transaction.failed? %>
          <%= render 'components/alert',
              variant: 'error',
              title: '✗ Transaction Failed',
              message: 'This transaction has failed. Please contact support if you believe this is an error.' %>
        <% end %>

        <div class="section-divider">
          <h2 class="section-title">Package Details</h2>
          <div class="detail-rows">
            <div class="detail-row">
              <span class="text-muted">Package</span>
              <span class="font-semibold"><%= @transaction.credit_package.name %></span>
            </div>
            <div class="detail-row">
              <span class="text-muted">Credits</span>
              <span class="font-semibold"><%= @transaction.credit_package.credits %> credits</span>
            </div>
            <div class="detail-row">
              <span class="text-muted">Price (USD)</span>
              <span class="font-semibold"><%= number_to_currency(@transaction.credit_package.price_usd) %></span>
            </div>
          </div>
        </div>

        <% if @transaction.btc_address.present? %>
          <div class="section-divider mt-6">
            <h2 class="section-title">Bitcoin Payment Details</h2>
            <div class="detail-rows">
              <% if @transaction.invoice_id.present? %>
                <div class="mb-4">
                  <label class="form-label text-sm">Invoice ID</label>
                  <code class="code-block"><%= @transaction.invoice_id %></code>
                </div>
              <% end %>

              <div class="mb-4">
                <label class="form-label text-sm">Bitcoin Address</label>
                <code class="code-block"><%= @transaction.btc_address %></code>
              </div>

              <% if @transaction.expected_btc.present? %>
                <div class="detail-row">
                  <span class="text-muted">Expected BTC</span>
                  <span class="font-mono font-semibold"><%= @transaction.expected_btc %> BTC</span>
                </div>
              <% end %>

              <% if @transaction.received_btc.present? && @transaction.received_btc > 0 %>
                <div class="detail-row">
                  <span class="text-muted">Received BTC</span>
                  <span class="font-mono font-semibold text-success"><%= @transaction.received_btc %> BTC</span>
                </div>
              <% end %>

              <% if @transaction.confirmations.present? && @transaction.confirmations > 0 %>
                <div class="detail-row">
                  <span class="text-muted">Confirmations</span>
                  <span class="font-semibold"><%= @transaction.confirmations %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="section-divider mt-6">
          <%= link_to "View All Transactions", credit_purchases_path, class: "btn btn-primary btn-full" %>

          <% if @transaction.pending? %>
            <button onclick="location.reload()" class="btn btn-primary btn-full mt-3">
              Refresh Status
            </button>
            <p class="text-center mt-4 text-sm text-muted">
              This page will automatically update when payment is received
            </p>
            <script>
              setTimeout(function() {
                location.reload();
              }, 30000);
            </script>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

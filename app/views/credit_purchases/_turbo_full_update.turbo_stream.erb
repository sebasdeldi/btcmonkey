<%# Common updates (status, alert, row) %>
<%= render 'credit_purchases/transaction_common_updates', transaction: transaction %>

<%# Full update specific: payment details %>
<%= turbo_stream.replace "transaction-#{transaction.id}-payment-details" do %>
  <%= render 'credit_purchases/payment_details', transaction: transaction %>
<% end %>

<%# Full update specific: wallet balance %>
<%= turbo_stream.replace "user-wallet-detail-#{transaction.user_id}" do %>
  <div id="user-wallet-detail-#{transaction.user_id}" class="wallet-card flex items-center justify-between">
    <%= render 'shared/wallet_balance', wallet: transaction.user.user_credit_wallet, available_credits: transaction.user.user_credit_wallet.total_credits %>
  </div>
<% end %>

<div class="container py-8">
  <div class="mb-8">
    <h1>Buy Credits</h1>
    <p>Choose a credit package and pay securely with Bitcoin</p>
  </div>

  <% if current_user.user_credit_wallet %>
    <%= render 'components/wallet_card', wallet: current_user.user_credit_wallet %>
  <% end %>

  <div class="packages-grid">
    <% @credit_packages.each do |package| %>
      <%= render 'components/package_card', package: package %>
    <% end %>
  </div>

  <div id="transactions-section" class="mt-8" style="<%= 'display: none;' unless current_user.btc_transactions.any? %>">
    <h2>Recent Transactions</h2>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Package</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="transactions-list">
          <% current_user.btc_transactions.order(created_at: :desc).limit(10).each do |transaction| %>
            <tr id="transaction-row-<%= transaction.id %>">
              <%= render 'credit_purchases/transaction_row', transaction: transaction %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

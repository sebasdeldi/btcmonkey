<div class="container py-8">
  <div class="mb-8">
    <h1>Buy Credits</h1>
    <p>Choose a credit package and pay securely with Bitcoin</p>
  </div>

  <% if current_user.user_credit_wallet %>
    <%= render 'components/wallet_card', wallet: current_user.user_credit_wallet %>
  <% end %>

  <div class="packages-grid">
    <% @credit_packages.each do |package| %>
      <%= render 'components/package_card', package: package %>
    <% end %>
  </div>

  <% if current_user.btc_transactions.any? %>
    <div class="mt-8">
      <h2>Recent Transactions</h2>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Package</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% current_user.btc_transactions.order(created_at: :desc).limit(10).each do |transaction| %>
              <tr>
                <td><%= transaction.created_at.strftime("%b %d, %Y") %></td>
                <td><%= transaction.credit_package.name %></td>
                <td><%= number_to_currency(transaction.credit_package.price_usd) %></td>
                <td>
                  <%= render 'components/status_badge', status: transaction.status %>
                </td>
                <td>
                  <%= link_to "View", credit_purchase_path(transaction), class: "link" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
